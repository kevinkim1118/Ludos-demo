{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/icons/**",
              "components/sentiment/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Familjen Grotesk|Newsreader))/i]",
        "message": "Font not provided by the design system. Available: Familjen Grotesk, Newsreader."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RelateChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|dot|key|ref|className|style|children)$/]",
        "message": "<RelateChip> doesn't accept that prop. Declared props: children, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='SentimentPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:sentiment|children|className|key|ref|className|style|children)$/]",
        "message": "<SentimentPill> doesn't accept that prop. Declared props: sentiment, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeRoot'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|children|key|ref|className|style|children)$/]",
        "message": "<ThemeRoot> doesn't accept that prop. Declared props: theme, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeRoot'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<ThemeRoot> theme must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|children|className|key|ref|className|style|children)$/]",
        "message": "<TrustBadge> doesn't accept that prop. Declared props: level, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictDistribution'] > JSXAttribute > JSXIdentifier[name!=/^(?:reallyLiked|liked|didntLike|reallyDisliked|key|ref|className|style|children)$/]",
        "message": "<VerdictDistribution> doesn't accept that prop. Declared props: reallyLiked, liked, didntLike, reallyDisliked."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
